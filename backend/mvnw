# Set the Maven home if the user has it defined
if [ -z "$MAVEN_HOME" ]; then
  export MAVEN_HOME="$(dirname "$(dirname "$(readlink -f "$0")")")"
fi

# Set the Java home if the user has it defined
if [ -z "$JAVA_HOME" ]; then
  export JAVA_HOME="$(/usr/libexec/java_home 2> /dev/null)" || export JAVA_HOME="$JAVACMD_PATH_FALLBACK"
fi

# Execute Maven
exec "$MAVEN_HOME/bin/mvn" "$@"